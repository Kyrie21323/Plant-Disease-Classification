# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
.venv/
venv/
env/
ENV/

# Outputs: ignore by default; allow key artifacts for a self-contained repo (no checkpoints)
outputs/*
!outputs/.gitkeep
!outputs/results/
!outputs/results/*.json
!outputs/results/*.md
!outputs/figures/
!outputs/figures/*.png
# Model weights - keep ignored (redundant with outputs/*, explicit for policy clarity)
outputs/checkpoints/**

# Data (keep folder, ignore contents; raw datasets never committed)
data/*
!data/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Logs & temp files
*.log
*.tmp
